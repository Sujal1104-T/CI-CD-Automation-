// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://cicd_user:cicd_password@127.0.0.1:5432/cicd_db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  provider  String   @default("local") // github, google
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pipelines Pipeline[]
}

model Pipeline {
  id          String   @id @default(uuid())
  name        String
  description String?
  repoUrl     String
  branch      String   @default("main")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  config      String?  // Store YAML or JSON config for now
  builds      Build[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Build {
  id         String    @id @default(uuid())
  pipelineId String
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id])
  status     String    @default("pending") // pending, running, success, failure, cancelled
  trigger    String    // manual, webhook, schedule
  startTime  DateTime?
  endTime    DateTime?
  jobs       Job[]
  createdAt  DateTime  @default(now())
}

model Job {
  id        String    @id @default(uuid())
  buildId   String
  build     Build     @relation(fields: [buildId], references: [id])
  name      String
  status    String    @default("pending")
  image     String    // Docker image used
  commands  String[]  // List of commands executed
  startTime DateTime?
  endTime   DateTime?
  logs      Log[]
}

model Log {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  content   String
  timestamp DateTime @default(now())
}
